{
  "profile_version": "2026-04-08",
  "profiles": [
    {
      "profile_id": "local_dev",
      "primary_use": "workstation development and debugging",
      "http": {
        "required": true,
        "command": "uvicorn app.main:APP --host 127.0.0.1 --port 8000 --reload",
        "health_url": "http://127.0.0.1:8000/health",
        "dashboard_url": "http://127.0.0.1:8000/console"
      },
      "mcp": {
        "required": true,
        "transport": "stdio",
        "command": "python3 app/mcp_server.py",
        "readiness_sequence": [
          "initialize",
          "notifications/initialized",
          "tools/list",
          "catalog.manifest"
        ]
      },
      "auth": {
        "recommended_mode": "jwt_local",
        "actor_context_source": "local bearer token or explicit cli/mcp actor args",
        "default_actor_role": "requester"
      },
      "restart_policy": {
        "http": "reload on source change",
        "mcp": "manual restart when source or prompt contract changes"
      }
    },
    {
